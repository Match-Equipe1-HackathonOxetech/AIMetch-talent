# Chave da API do Gemini (obrigatória)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Segredo usado para assinar os JWTs — troque em produção
JWT_SECRET=troque-esta-chave-em-producao

# String de conexão do banco.
# SQLite (padrão, bom só para desenvolvimento local):
# DATABASE_URL=sqlite:///recrutamento.db
# Postgres:
DATABASE_URL=postgresql://usuario:senha@localhost:5432/recrutamento
